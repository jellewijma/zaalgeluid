{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "VITE_APP_MODE=cloud APP_BASE_PATH=/play-audio VITE_CONVEX_BACKEND_URL=https://appa.tailf12edd.ts.net:10000 VITE_AUTH_STORAGE_NAMESPACE=https://dependable-lynx-178.eu-west-1.convex.cloud/play-audio/ npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/", "destination": "/play-audio", "permanent": false }
  ],
  "rewrites": [
    { "source": "/play-audio/assets/:path*", "destination": "/assets/:path*" },
    { "source": "/play-audio/favicon.svg", "destination": "/favicon.svg" },
    { "source": "/play-audio/google-g.png", "destination": "/google-g.png" },
    { "source": "/play-audio/manifest.webmanifest", "destination": "/manifest.webmanifest" },
    { "source": "/play-audio/sw.js", "destination": "/sw.js" },
    { "source": "/play-audio/icons/:path*", "destination": "/icons/:path*" },
    { "source": "/play-audio", "destination": "/index.html" },
    { "source": "/play-audio/", "destination": "/index.html" },
    { "source": "/play-audio/launch", "destination": "/index.html" },
    { "source": "/play-audio/player", "destination": "/index.html" },
    { "source": "/play-audio/privacy", "destination": "/index.html" },
    { "source": "/play-audio/control", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' data: blob: https://appa.tailf12edd.ts.net:10000; connect-src 'self' https://appa.tailf12edd.ts.net:10000 wss://appa.tailf12edd.ts.net:10000; object-src 'none'; base-uri 'self'; frame-ancestors 'self'" },
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "same-origin" },
      { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
    ] },
    { "source": "/play-audio/assets/:path*", "headers": [
      { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
    ] },
    { "source": "/play-audio/manifest.webmanifest", "headers": [
      { "key": "Content-Type", "value": "application/manifest+json" },
      { "key": "Cache-Control", "value": "no-cache" }
    ] },
    { "source": "/play-audio/sw.js", "headers": [
      { "key": "Content-Type", "value": "application/javascript; charset=utf-8" },
      { "key": "Cache-Control", "value": "no-cache" }
    ] },
    { "source": "/play-audio/:page(player|control|launch)?", "headers": [
      { "key": "Cache-Control", "value": "no-store" }
    ] }
  ]
}
