{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/", "destination": "/play-audio", "permanent": false }
  ],
  "rewrites": [
    { "source": "/play-audio/assets/:path*", "destination": "/assets/:path*" },
    { "source": "/play-audio/favicon.svg", "destination": "/favicon.svg" },
    { "source": "/play-audio", "destination": "/index.html" },
    { "source": "/play-audio/", "destination": "/index.html" },
    { "source": "/play-audio/player", "destination": "/index.html" },
    { "source": "/play-audio/control", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' data: blob: https://dependable-lynx-178.eu-west-1.convex.cloud https://dependable-lynx-178.eu-west-1.convex.site; connect-src 'self' https://dependable-lynx-178.eu-west-1.convex.cloud wss://dependable-lynx-178.eu-west-1.convex.cloud https://dependable-lynx-178.eu-west-1.convex.site; object-src 'none'; base-uri 'self'; frame-ancestors 'self'" },
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "same-origin" },
      { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
    ] },
    { "source": "/play-audio/assets/:path*", "headers": [
      { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
    ] },
    { "source": "/play-audio/:page(player|control)?", "headers": [
      { "key": "Cache-Control", "value": "no-store" }
    ] }
  ]
}
